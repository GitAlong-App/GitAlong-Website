# Copy to .env.local for local development. All VITE_* values are bundled into
# the browser build, so never put secrets here (no service-role keys, no GitHub tokens).

# Supabase project (Settings -> API). The anon key is public; RLS protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# GitAlong FastAPI backend origin (no /api/v1 suffix)
VITE_BACKEND_URL=https://gitalong-backend.onrender.com

# Public URL of this site
VITE_APP_URL=https://gitalong.app
